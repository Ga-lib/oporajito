# ==========================================
# Oporajito Backend Environment Variables
# ==========================================

# Application Settings
PROJECT_NAME="Oporajito"
ENVIRONMENT="development"  # or "production"
PORT=8000

# ------------------------------------------
# MongoDB Database
# ------------------------------------------
# Local MongoDB (Development):
MONGODB_URI="mongodb://127.0.0.1:27017"

# MongoDB Atlas Free Tier (Production):
# Create a free M0 cluster at https://mongodb.com/cloud/atlas
# Example: MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="oporajito_db"

# ------------------------------------------
# Authentication & Firebase
# ------------------------------------------
# Path to downloaded Firebase service account JSON key file
# Optional in local dev: if absent, ALLOW_DEV_TOKENS=True enables instant local testing
FIREBASE_CREDENTIALS_PATH="serviceAccountKey.json"

# Enables zero-friction dev tokens (+88017... test numbers) for rapid local testing
ALLOW_DEV_TOKENS=True

# ------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------
# JSON list of allowed frontend origins
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "https://*.vercel.app"]'
